{
  "name": "dsh-shell",
  "description": "Select the shell for DSH agent commands and persistent terminals",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "main": "./index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./client": "./client.js",
    "./shell": "./shell.mjs",
    "./shell-windows": "./shell-windows.mjs",
    "./terminal": "./terminal.mjs",
    "./persistent": "./persistent.mjs",
    "./package.json": "./package.json",
    "./tool-windows": "./tool-windows.mjs",
    "./preset": "./preset.mjs",
    "./tool-posix": "./tool-posix.mjs"
  },
  "files": [
    "client.js",
    "index.mjs",
    "selection.mjs",
    "shell.mjs",
    "shell-windows.mjs",
    "bash-runtime.mjs",
    "tool-windows.mjs",
    "terminal.mjs",
    "persistent.mjs",
    "posix-runtime.mjs",
    "tool-posix.mjs",
    "tool-context.mjs",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "preset.mjs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "test": "node --test"
  }
}
