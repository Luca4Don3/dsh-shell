{
  "name": "dsh-shell",
  "description": "Select the shell for DSH agent commands and persistent terminals",
  "version": "0.3.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Luca4Don3/dsh-shell.git"
  },
  "private": true,
  "type": "module",
  "main": "./index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./client": "./client.js",
    "./shell": "./shell.mjs",
    "./assembly": "./assembly.mjs",
    "./shell-windows": "./shell-windows.mjs",
    "./terminal": "./terminal.mjs",
    "./persistent": "./persistent.mjs",
    "./package.json": "./package.json",
    "./tool-windows": "./tool-windows.mjs",
    "./preset": "./preset.mjs",
    "./tool-posix": "./tool-posix.mjs"
  },
  "files": [
    "LICENSE",
    "client.js",
    "index.mjs",
    "selection.mjs",
    "shell.mjs",
    "assembly.mjs",
    "shell-windows.mjs",
    "bash-runtime.mjs",
    "tool-windows.mjs",
    "terminal.mjs",
    "persistent.mjs",
    "persistent-runtime.mjs",
    "posix-runtime.mjs",
    "bash-startup.bash",
    "tool-posix.mjs",
    "job-kinds.mjs",
    "tool-context.mjs",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "preset.mjs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": "0.2.0-rc.2"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1",
    "test:native": "node -e \"if (!process.env.DSH_OFFICIAL_ROOT) throw new Error('Set DSH_OFFICIAL_ROOT to an isolated DSH 0.2.0-rc.2 installation')\" && node --test --test-concurrency=1 test/native-assembly.test.mjs test/native-differential.test.mjs test/native-jobs.test.mjs test/native-profile-lifecycle.test.mjs"
  }
}
