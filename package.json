{
  "name": "dsh-shell",
  "description": "Select the shell for DSH agent commands and persistent terminals",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "main": "./index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./client": "./client.js",
    "./shell": "./shell.mjs",
    "./shell-windows": "./shell-windows.mjs",
    "./terminal": "./terminal.mjs",
    "./persistent": "./persistent.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "client.js",
    "index.mjs",
    "selection.mjs",
    "shell.mjs",
    "shell-windows.mjs",
    "terminal.mjs",
    "persistent.mjs",
    ".zshenv",
    ".zprofile",
    ".zshrc",
    ".zlogin",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ],
      "platform": "web"
    }
  }
}
